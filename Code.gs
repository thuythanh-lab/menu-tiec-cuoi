/** Run setup_ ONCE from the bound Sheet's script editor, never from a web client. */
function setup_(){var ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss)throw Error('Hãy mở Apps Script từ Google Sheet.');var p=PropertiesService.getScriptProperties();p.setProperty('SHEET_ID',ss.getId());if(!p.getProperty('ACCESS_TOKEN'))p.setProperty('ACCESS_TOKEN',Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,''));ss.setSpreadsheetTimeZone('Asia/Ho_Chi_Minh');ensureSheets_();Logger.log('Đã khởi tạo. Triển khai web app rồi chạy getShareUrl_.');}
function getShareUrl_(){var t=PropertiesService.getScriptProperties().getProperty('ACCESS_TOKEN'),u=ScriptApp.getService().getUrl();if(!u||!t)throw Error('Chạy setup_ và triển khai web app trước.');Logger.log(u+'?token='+encodeURIComponent(t));}
function rotateAccessToken_(){PropertiesService.getScriptProperties().setProperty('ACCESS_TOKEN',Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,''));getShareUrl_();}
function auth_(token){var expected=PropertiesService.getScriptProperties().getProperty('ACCESS_TOKEN');if(!expected||typeof token!=='string'||token.length!==expected.length)throw Error('Liên kết không hợp lệ. Nhờ Thủy gửi lại link riêng nhé.');var diff=0;for(var i=0;i<expected.length;i++)diff|=expected.charCodeAt(i)^token.charCodeAt(i);if(diff)throw Error('Liên kết không hợp lệ.');}
function doGet(e){try{var token=e&&e.parameter&&e.parameter.token;auth_(token);var t=HtmlService.createTemplateFromFile('Index');t.bootJson=JSON.stringify({token:token}).replace(/</g,'\\u003c');return t.evaluate().setTitle('Thực đơn cưới · Minh & Thủy').addMetaTag('viewport','width=device-width, initial-scale=1, viewport-fit=cover');}catch(err){return HtmlService.createHtmlOutput('<h2>Thiệp chọn món riêng của gia đình</h2><p>Nhờ Thủy gửi lại liên kết đầy đủ để mở nhé.</p>');}}
function include_(name){return HtmlService.createHtmlOutputFromFile(name).getContent();}
function spreadsheet_(){var id=PropertiesService.getScriptProperties().getProperty('SHEET_ID');if(!id)throw Error('Chưa thiết lập Google Sheet.');return SpreadsheetApp.openById(id);}
var SHEETS_=['THỰC ĐƠN HIỆN TẠI','LỊCH SỬ THỰC ĐƠN','BÁO GIÁ & DỰ TOÁN'];
function ensureSheets_(){var ss=spreadsheet_();SHEETS_.forEach(function(n){if(!ss.getSheetByName(n))ss.insertSheet(n);});var h=ss.getSheetByName(SHEETS_[1]);if(!h.getLastRow())h.appendRow(['Revision ID','Thời gian ISO','Request ID','Nội dung chuẩn JSON','Thực đơn JSON','Dự toán đầu vào JSON','Kết quả JSON','Trạng thái']);return ss;}
function latest_(ss){var h=ss.getSheetByName(SHEETS_[1]);if(h.getLastRow()<2)return null;var r=h.getRange(h.getLastRow(),1,1,8).getValues()[0];var data=JSON.parse(r[3]);return {revision:r[0],savedAt:r[1],selections:data.selections,pricing:data.pricing,estimate:estimate_(data.pricing,data.selections)};}
function loadConfirmed(token){auth_(token);var lock=LockService.getScriptLock();lock.waitLock(15000);try{var ss=ensureSheets_(),latest=latest_(ss);if(latest)project_(ss,latest);return latest;}finally{lock.releaseLock();}}
function saveConfirmed(token,payload,requestId,baseRevision){auth_(token);if(typeof requestId!=='string'||!/^[a-zA-Z0-9][a-zA-Z0-9-]{15,99}$/.test(requestId))throw Error('Mã lưu không hợp lệ.');var data=normalized_(payload),json=JSON.stringify(data);var lock=LockService.getScriptLock();lock.waitLock(20000);try{var ss=ensureSheets_(),h=ss.getSheetByName(SHEETS_[1]),last=latest_(ss),rows=h.getLastRow()>1?h.getRange(2,1,h.getLastRow()-1,4).getValues():[];
 var prior=rows.find(function(r){return r[2]===requestId;});if(prior){if(prior[3]!==json)throw Error('Mã lưu đã được dùng cho dữ liệu khác.');if(last)project_(ss,last);var same=JSON.parse(prior[3]);return {revision:prior[0],savedAt:prior[1],selections:same.selections,pricing:same.pricing,estimate:estimate_(same.pricing,same.selections)};}
 if((last?last.revision:null)!==(baseRevision||null))throw Error('CONFLICT: Có thực đơn mới hơn được lưu trên thiết bị khác. Bản nháp vẫn được giữ; tải bản đã lưu trước khi lưu tiếp.');
 if(last&&JSON.stringify({selections:last.selections,pricing:last.pricing})===json){project_(ss,last);return last;}
 var record={revision:Utilities.getUuid(),savedAt:new Date().toISOString(),selections:data.selections,pricing:data.pricing,estimate:estimate_(data.pricing,data.selections)};
 // Append-only journal is authoritative. Projections can be rebuilt if a later write fails.
 h.appendRow([record.revision,record.savedAt,requestId,json,JSON.stringify(data.selections),JSON.stringify(data.pricing),JSON.stringify(record.estimate),'Gia đình xác nhận lựa chọn; '+(record.estimate.provisional?'dự toán còn khoản chờ':'giá đã xác nhận')]);SpreadsheetApp.flush();project_(ss,record);SpreadsheetApp.flush();return record;
 }finally{lock.releaseLock();}}
function safeCell_(v){return typeof v==='string'&&/^[\s]*[=+@-]/.test(v)?"'"+v:v;}
function writeRows_(sheet,rows){var width=Math.max.apply(null,rows.map(function(r){return r.length;}));var padded=rows.map(function(r){return Array.from({length:width},function(_,i){return safeCell_(r[i]===undefined?'':r[i]);});});sheet.getRange(1,1,padded.length,width).setValues(padded);if(sheet.getLastRow()>padded.length)sheet.getRange(padded.length+1,1,sheet.getLastRow()-padded.length,width).clearContent();sheet.setFrozenRows(1);sheet.getRange(1,1,1,width).setBackground('#81917D').setFontColor('#ffffff').setFontWeight('bold');sheet.getDataRange().setFontFamily('Arial').setFontSize(11).setWrap(true).setVerticalAlignment('middle');sheet.setColumnWidths(1,width,180);sheet.setColumnWidth(1,70);sheet.setColumnWidth(3,280);}
function project_(ss,r){if(r.pricing.mode==='perGuest')return projectPerGuest_(ss,r);var p=r.pricing,e=r.estimate,ref=e.reference;var rows=[['STT','Nhóm món','Món đã chọn','Gói mẫu có món','Gói tham khảo','Cần hỏi phụ thu?','Ghi chú']];CATEGORIES.forEach(function(c,i){var d=selectedDish_(r.selections,c);rows.push([i+1,c.name,d.name,PACKAGES.filter(function(x){return d.packages.indexOf(x.id)>=0;}).map(function(x){return x.name;}).join(', '),ref.name,d.packages.indexOf(ref.id)<0?'Cần hỏi Seasons':'Có trong gói mẫu','']);});
 rows.push([],['THÔNG TIN TIỆC CƯỚI'],['Cặp đôi','Minh & Thủy'],['Ngày cưới','24/12/2026'],['Địa điểm','Seasons – Đào Duy Anh'],['Số khách',e.guests,e.guestSource],['Số bàn',p.tables,p.directGuests===null?'Dùng tính khách':'Chỉ tham khảo; dùng số khách nhập trực tiếp'],['Gói tham khảo',ref.name],['Đơn giá ăn/khách',e.price,e.custom?'Báo giá Seasons đã xác nhận':'Giá tham khảo + phụ thu đã nhập'],['Tiền ăn',e.food],['Phụ thu đổi món',e.substitution,e.custom?'Đã nằm trong báo giá thực đơn':'Đã nằm trong tiền ăn; không cộng lại'],['Đồ uống',p.drinks.status==='unknown'?'Chờ báo giá':e.drinks],['Phí phục vụ',e.service,p.serviceRate+'%; '+p.serviceBase+(p.serviceConfirmed?' — đã xác nhận':' — cơ sở tạm tính')],['VAT',p.vat.status==='unknown'?'Chưa xác nhận':e.vat,p.vatBase],['Chi phí khác',p.other.status==='unknown'?'Chưa có thông tin':e.other],['TẠM TÍNH PHẦN ĐÃ BIẾT',e.total],['Trạng thái giá',e.provisional?'Dự toán; còn khoản chờ xác nhận':'Giá đã được Seasons xác nhận theo thông tin gia đình nhập'],['Còn chờ',e.pending.join('; ')],['Cập nhật',r.savedAt],['Revision',r.revision]);writeRows_(ss.getSheetByName(SHEETS_[0]),rows);
 var financial=[['Hạng mục','Đơn giá','Số lượng','Thành tiền','Trạng thái','Ghi chú'],['Gói tham khảo',ref.price,e.guests,'','Giá mẫu',ref.name],['Số khách','',e.guests,'',e.guestSource,''],['Tiền ăn',e.price,e.guests,e.food,e.custom?'Báo giá đã xác nhận':'Giá tham khảo','Bao gồm phụ thu đã nhập nếu dùng gói tham khảo'],['Phụ thu đổi món',p.substitution.value,e.guests,e.substitution,e.custom?'Đã gộp trong báo giá':p.substitution.status,'Thông tin phân tích; không cộng hai lần'],['Đồ uống',p.drinks.value,e.guests,p.drinks.status==='unknown'?'':e.drinks,p.drinks.status,''],['Phí phục vụ',p.serviceRate+'%',p.serviceBase,e.service,p.serviceConfirmed?'Đã xác nhận':'Cơ sở chờ xác nhận',''],['VAT',p.vat.value===null?'':p.vat.value+'%',p.vatBase,p.vat.status==='unknown'?'':e.vat,p.vat.status,''],['Chi phí khác',p.other.value,1,p.other.status==='unknown'?'':e.other,p.other.status,''],['TẠM TÍNH PHẦN ĐÃ BIẾT','','',e.total,e.provisional?'Dự toán':'Đã xác nhận',''],['Còn chờ','','','',e.pending.join('; '),''],[],['CẬP NHẬT BÁO GIÁ','Mở app → Dự toán → nhập giá đã xác nhận → Xác nhận & lưu.'],['Lưu ý','Bảng này tự đồng bộ từ app. Sửa trực tiếp ô báo cáo không thay đổi thực đơn đã lưu.']];writeRows_(ss.getSheetByName(SHEETS_[2]),financial);
}

function projectPerGuest_(ss,r){var e=estimatePerGuest_(r.selections),ref=e.reference;var rows=[['STT','Nhóm món','Món đã chọn','Gói mẫu có món','Gói tham khảo','Cần hỏi phụ thu?','Ghi chú']];CATEGORIES.forEach(function(c,i){var d=selectedDish_(r.selections,c);rows.push([i+1,c.name,d.name,PACKAGES.filter(function(x){return d.packages.indexOf(x.id)>=0;}).map(function(x){return x.name;}).join(', '),ref.name,d.packages.indexOf(ref.id)<0?'Cần Seasons xác nhận giá':'Có trong gói mẫu','']);});rows.push([],['THÔNG TIN TIỆC CƯỚI'],['Cặp đôi','Minh & Thủy'],['Ngày cưới','24/12/2026'],['Địa điểm','Seasons – Đào Duy Anh'],['ƯỚC TÍNH / KHÁCH',e.rounded,'Làm tròn 10.000đ; đã tạm cộng phí phục vụ 5%'],['Cách tính','Mỗi món: trung bình các gói có món đó; lấy trung bình 11 mức tham chiếu × 1,05'],['Trung bình trước phí',e.packageAverage],['Gói gần nhất',ref.name,e.matched+'/11 món trùng'],['Giá trước làm tròn',e.exact],['Chưa gồm','Đồ uống, VAT; giá thực đơn kết hợp cần Seasons xác nhận'],['Trạng thái','Giá tham khảo, không phải báo giá thực đơn kết hợp'],['Số khách','Chưa cung cấp'],['Số bàn','Chưa cung cấp'],['Tổng tiệc','Không tính; chỉ ước tính một khách'],['Cập nhật',r.savedAt],['Revision',r.revision]);writeRows_(ss.getSheetByName(SHEETS_[0]),rows);writeRows_(ss.getSheetByName(SHEETS_[2]),[['Hạng mục','Đơn giá','Số lượng','Thành tiền','Trạng thái','Ghi chú'],['ƯỚC TÍNH / KHÁCH',e.rounded,'1 khách (đơn vị ước tính)','','Giá tham khảo','Không phải tổng tiệc'],['Trung bình giá gói nguồn',e.packageAverage,'11 nhóm món','','Giá tham khảo','Trung bình các gói chứa mỗi món, rồi trung bình 11 nhóm'],['Phí phục vụ','5%','','','Tạm tính trên tiền ăn','Đã nằm trong ước tính / khách'],['Giá trước làm tròn',e.exact,'','','Giá tham khảo','Làm tròn đến 10.000đ khi hiển thị'],['Đồ uống','','','','Chưa có báo giá','Chưa tính'],['VAT','','','','Chưa xác nhận','Chưa tính'],['Thực đơn kết hợp','','','','Chờ Seasons xác nhận','Không suy ra phụ thu hay giá từng món'],['Số khách / bàn','','','','Chư